<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP cleartext untuk build debug ditangani oleh
         src/debug/res/xml/network_security_config.xml (base-config
         cleartextTrafficPermitted="true"). Atribut
         android:usesCleartextTraffic diabaikan Android 7.0+ selama
         Android Network Security Config tersedia. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
